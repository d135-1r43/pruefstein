# Copy this file to .env and fill in real values. Never commit .env.
# Note: first deployment assumes a clean (empty) database. If migrating an
# existing database, rename the keycloak_subject column to oidc_subject first.

# PostgreSQL
POSTGRES_DB=pruefstein
POSTGRES_USER=pruefstein
POSTGRES_PASSWORD=CHANGE_ME

# Entra ID — values from your app registration in the Azure portal
ENTRA_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ENTRA_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ENTRA_CLIENT_SECRET=CHANGE_ME

# OpenAI
OPENAI_API_KEY=sk-CHANGE_ME
